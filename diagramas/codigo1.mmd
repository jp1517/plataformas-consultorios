flowchart TD
    ini([Inicio])
    val{Monto mayor a cero?}
    exc{Excede el saldo?}
    apl[Aplicar el abono]
    err1[Monto invalido]
    err2[Excede el saldo]
    fin([Fin])
    ini --> val
    val -->|No| err1
    val -->|Si| exc
    exc -->|Si| err2
    exc -->|No| apl
    err1 --> fin
    err2 --> fin
    apl --> fin
    style apl fill:#ff5d00,color:#fff
